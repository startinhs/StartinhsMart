@page "/categories"

@attribute [Authorize(CoreServicePermissions.Categories.Default)]
@using StartinhsMart.CoreService.Categories
@using StartinhsMart.CoreService.Localization
@using StartinhsMart.CoreService.Shared
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@using Microsoft.AspNetCore.Components.Web
@using Blazorise
@using Blazorise.Components
@using Blazorise.DataGrid
@using Volo.Abp.BlazoriseUI
@using Volo.Abp.BlazoriseUI.Components
@using Volo.Abp.ObjectMapping
@using Volo.Abp.AspNetCore.Components.Messages
@using Volo.Abp.AspNetCore.Components.Web.Theming.Layout
@using StartinhsMart.CoreService.Permissions
@using Volo.Abp.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components
@using Volo.Abp.Http.Client
@inherits CoreServiceComponentBase
@inject ICategoriesAppService CategoriesAppService
@inject IUiMessageService UiMessageService
@inject AbpBlazorMessageLocalizerHelper<CoreServiceResource> LH
@inject IRemoteServiceConfigurationProvider RemoteServiceConfigurationProvider
@inject NavigationManager NavigationManager

@* ************************* PAGE HEADER ************************* *@
<PageHeader Title="@L["Categories"]" BreadcrumbItems="BreadcrumbItems" Toolbar="Toolbar">
</PageHeader>

@* ************************* SEARCH ************************* *@
<Card>
    <CardBody>
        <Row>
            <div class="col-md-6">
                <div class="mb-3">
                    <Form id="CategorySearchForm">
                        <Addons>
                            <Addon AddonType="AddonType.Body">
                                <TextEdit @bind-Text="@Filter.FilterText"
                                        Autofocus="true"
                                        Placeholder="@L["Search"]">
                                </TextEdit>
                            </Addon>
                            <Addon AddonType="AddonType.End">
                                <SubmitButton Form="CategorySearchForm" Clicked="GetCategoriesAsync">
                                    <Icon Name="IconName.Search" Class="me-1"></Icon>@L["Search"]
                                </SubmitButton>
                            </Addon>
                        </Addons>
                    </Form>
                </div>
            </div>
            <div class="col-md-6">
                <div class="mb-3">
                    <Button Color="Color.Primary" Outline Style="width:100%" id="AdvancedFilterSectionToggler"
                            Clicked="@(() => ShowAdvancedFilters = !ShowAdvancedFilters)">@L["Filters"]
                        <i aria-hidden="true" class="fa ms-1 @(!ShowAdvancedFilters ? "fa-angle-down" : "fa-angle-up")"></i>
                    </Button>
                </div>
            </div>
        </Row>

        @if (ShowAdvancedFilters)
        {
            <Div Style="display:block" class="mt-3">
                <Row>
                    <Div ColumnSize="ColumnSize.Is12.OnTablet.Is6.OnDesktop">
                        <Field>
                            <FieldLabel>@L["Name"]</FieldLabel>
                            <TextEdit @bind-Text="@Filter.Name" Placeholder=""/>
                        </Field>
                    </Div>
                    <Div ColumnSize="ColumnSize.Is12.OnTablet.Is6.OnDesktop">
                        <Field>
                            <FieldLabel>@L["Slug"]</FieldLabel>
                            <TextEdit @bind-Text="@Filter.Slug" Placeholder=""/>
                        </Field>
                    </Div>
                </Row>
                <Row>
                    <Div ColumnSize="ColumnSize.Is12.OnTablet.Is6.OnDesktop">
                        <Field>
                            <FieldLabel>@L["IsActive"]</FieldLabel>
                            <Select @bind-SelectedValue="@Filter.IsActive">
                                <SelectItem Value="@((bool?)null)">@L["All"]</SelectItem>
                                <SelectItem Value="@((bool?)true)">@L["Yes"]</SelectItem>
                                <SelectItem Value="@((bool?)false)">@L["No"]</SelectItem>
                            </Select>
                        </Field>
                    </Div>
                </Row>
                <Row>
                    <Div ColumnSize="ColumnSize.Is12">
                        <Button Color="Color.Info" Clicked="GetCategoriesAsync">@L["Filter"]</Button>
                    </Div>
                </Row>
            </Div>
        }
    </CardBody>
</Card>

@* ************************* DATA GRID ************************* *@
<Card>
    <CardHeader>
    </CardHeader>
    <CardBody>
        <DataGrid @ref="CategoriesDataGrid"
                TItem="CategoryDto"
                Data="CategoryList"
                ReadData="OnDataGridReadAsync"
                TotalItems="TotalCount"
                ShowPager="true"
                Responsive="true">
            <DataGridColumns>
                <DataGridColumn Field="@nameof(CategoryDto.Id)" Caption="@L["Actions"]" Width="150px">
                    <DisplayTemplate>
                        <EntityActions>
                            @if (CanEditCategory)
                            {
                                <EntityAction IconName="IconName.Edit" Text="@L["Edit"]" 
                                            Clicked="@(async () => await OpenEditCategoryModal(context))" />
                            }
                            @if (CanDeleteCategory)
                            {
                                <EntityAction IconName="IconName.Delete" Text="@L["Delete"]" 
                                            Clicked="@(async () => await DeleteCategoryAsync(context))" />
                            }
                        </EntityActions>
                    </DisplayTemplate>
                </DataGridColumn>
                <DataGridColumn Field="@nameof(CategoryDto.Name)" Caption="@L["Name"]" />
                <DataGridColumn Field="@nameof(CategoryDto.Slug)" Caption="@L["Slug"]" />
                <DataGridColumn Field="@nameof(CategoryDto.SortOrder)" Caption="@L["SortOrder"]" Width="100px" />
                <DataGridColumn Field="@nameof(CategoryDto.IsActive)" Caption="@L["IsActive"]" Width="100px">
                    <DisplayTemplate>
                        <Badge Color="@(context.IsActive ? Color.Success : Color.Danger)">
                            @(context.IsActive ? L["Yes"] : L["No"])
                        </Badge>
                    </DisplayTemplate>
                </DataGridColumn>
                <DataGridColumn Field="@nameof(CategoryDto.CreationTime)" Caption="@L["CreationTime"]" DisplayFormat="{0:G}" />
            </DataGridColumns>
        </DataGrid>
    </CardBody>
</Card>

@* ************************* CREATE MODAL ************************* *@
<Modal @ref="CreateCategoryModal">
    <ModalContent Centered="true">
        <ModalHeader>
            <ModalTitle>@L["NewCategory"]</ModalTitle>
            <CloseButton Clicked="CloseCreateCategoryModal"></CloseButton>
        </ModalHeader>
        <ModalBody>
            <Form id="CreateCategoryForm">
                <Validations @ref="CreateCategoryValidations" Model="@NewCategory" ValidateOnLoad="false">
                    <Validation MessageLocalizer="@LH.Localize">
                        <Field>
                            <FieldLabel>@L["Name"]</FieldLabel>
                            <TextEdit @bind-Text="NewCategory.Name" MaxLength="256">
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>

                    <Field>
                        <FieldLabel>@L["Slug"]</FieldLabel>
                        <TextEdit @bind-Text="NewCategory.Slug" MaxLength="256"/>
                    </Field>

                    <Validation MessageLocalizer="@LH.Localize">
                        <Field>
                            <FieldLabel>@L["SortOrder"]</FieldLabel>
                            <NumericPicker @bind-Value="NewCategory.SortOrder" />
                        </Field>
                    </Validation>

                    <Field>
                        <FieldLabel>@L["Description"]</FieldLabel>
                        <MemoEdit @bind-Text="NewCategory.Description" Rows="5" MaxLength="2000" />
                    </Field>

                    <Field>
                        <Check @bind-Checked="NewCategory.IsActive">@L["IsActive"]</Check>
                    </Field>
                </Validations>
            </Form>
        </ModalBody>
        <ModalFooter>
            <Button Color="Color.Secondary" Clicked="CloseCreateCategoryModal">@L["Cancel"]</Button>
            <Button Color="Color.Primary" Type="ButtonType.Submit" Form="CreateCategoryForm" PreventDefaultOnSubmit="true"
                    Clicked="CreateCategoryAsync">
                @L["Save"]
            </Button>
        </ModalFooter>
    </ModalContent>
</Modal>

@* ************************* EDIT MODAL ************************* *@
<Modal @ref="EditCategoryModal">
    <ModalContent Centered="true">
        <ModalHeader>
            <ModalTitle>@L["Edit"]</ModalTitle>
            <CloseButton Clicked="CloseEditCategoryModal"></CloseButton>
        </ModalHeader>
        <ModalBody>
            <Form id="EditCategoryForm">
                <Validations @ref="EditCategoryValidations" Model="@EditingCategory" ValidateOnLoad="false">
                    <Validation MessageLocalizer="@LH.Localize">
                        <Field>
                            <FieldLabel>@L["Name"]</FieldLabel>
                            <TextEdit @bind-Text="EditingCategory.Name" MaxLength="256">
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>

                    <Field>
                        <FieldLabel>@L["Slug"]</FieldLabel>
                        <TextEdit @bind-Text="EditingCategory.Slug" MaxLength="256"/>
                    </Field>

                    <Validation MessageLocalizer="@LH.Localize">
                        <Field>
                            <FieldLabel>@L["SortOrder"]</FieldLabel>
                            <NumericPicker @bind-Value="EditingCategory.SortOrder" />
                        </Field>
                    </Validation>

                    <Field>
                        <FieldLabel>@L["Description"]</FieldLabel>
                        <MemoEdit @bind-Text="EditingCategory.Description" Rows="5" MaxLength="2000" />
                    </Field>

                    <Field>
                        <Check @bind-Checked="EditingCategory.IsActive">@L["IsActive"]</Check>
                    </Field>
                </Validations>
            </Form>
        </ModalBody>
        <ModalFooter>
            <Button Color="Color.Secondary" Clicked="CloseEditCategoryModal">@L["Cancel"]</Button>
            <Button Color="Color.Primary" Type="ButtonType.Submit" Form="EditCategoryForm" PreventDefaultOnSubmit="true"
                    Clicked="UpdateCategoryAsync">
                @L["Update"]
            </Button>
        </ModalFooter>
    </ModalContent>
</Modal>
