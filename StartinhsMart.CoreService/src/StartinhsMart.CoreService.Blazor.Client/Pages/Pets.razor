                            </TextEdit>
                        </Field>
                    </Validation>


                    <Validation MessageLocalizer="@LH.Localize">
                        <Field>
                            <FieldLabel>@L["Vaccinations"]</FieldLabel>
                            <NumericPicker TValue="int?" @bind-Value="@EditingPet.Vaccinations"  Decimals="0" >
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                             </NumericPicker>
                        </Field>
                     </Validation>


                    <Validation MessageLocalizer="@LH.Localize">
                        <Field>
                            <FieldLabel>@L["Description"]</FieldLabel>
                            <TextEdit @bind-Text="@EditingPet.Description"  >
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>


                    <Validation MessageLocalizer="@LH.Localize">
                        <Field>
                            <FieldLabel>@L["Price"]</FieldLabel>
                            <NumericPicker TValue="decimal?" @bind-Value="@EditingPet.Price"   >
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                             </NumericPicker>
                        </Field>
                     </Validation>


                    <Validation MessageLocalizer="@LH.Localize">
                        <Field>
                            <FieldLabel>@L["Quantity"]</FieldLabel>
                            <NumericPicker TValue="int?" @bind-Value="@EditingPet.Quantity"  Decimals="0" >
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                             </NumericPicker>
                        </Field>
                     </Validation>


                    <Field>
                        <Check TValue="bool" @bind-Checked="@EditingPet.IsBooth" >@L["IsBooth"]</Check>
                    </Field>

                    <Field>
                        <Check TValue="bool" @bind-Checked="@EditingPet.IsStock" >@L["IsStock"]</Check>
                    </Field>

                    
                    
                </Validations>
            </ModalBody>
            <ModalFooter>
                <Button Color="Color.Secondary"
                        Clicked="CloseEditPetModalAsync">
                    @L["Cancel"]
                </Button>
                <SubmitButton Form="EditPetForm" Clicked="UpdatePetAsync" Disabled="@IsEditFormDisabled()" />

            </ModalFooter>
        </Form>

    </ModalContent>
</Modal>

@* ************************* IMAGE SEARCH MODAL ************************* *@
<div id="imageSearchModal" class="modal" style="display: @(showImageSearchModal ? "flex" : "none")">
    <div class="modal-content">
        <span class="close" @onclick="CloseImageSearchModal">&times;</span>
        <div class="container" style="display: flex; justify-content: space-between; align-items: center;">

            <!-- Image Upload Area -->
            <div style="text-align: center;">
                <br />
                <h4>Upload Image</h4>
                <br />
                <div style="display: flex; flex-direction: column; align-items: center;">
                    <InputFile OnChange="UploadImage" accept="image/*" />
                    <br />
                    <div style="width: 120px; height: 120px; display: flex; align-items: center; justify-content: center;
                        border: 2px solid #ccc; border-radius: 10px; padding: 5px; margin-top: 10px;">
                        @if (!string.IsNullOrEmpty(ImagePreview))
                        {
                            <img src="@ImagePreview" alt="Uploaded Image"
                                 style="max-width: 100px; max-height: 100px; object-fit: cover;" />
                        }
                        else
                        {
                            <div style="color: #999; font-size: 12px; text-align: center;">
                                <i class="fa fa-image" style="font-size: 24px; margin-bottom: 5px;"></i><br />
                                No image
                            </div>
                        }
                    </div>
                </div>
                <br />
                <div style="display: flex; justify-content: center; gap: 10px; margin-top: 10px;">
                    <button @onclick="ShowWebcamPopup"
                            style="display: flex; align-items: center; justify-content: center;
                               background-color: indianred; color: white; padding: 12px 30px;
                               border: none; border-radius: 8px; font-size: 16px; font-weight: bold;
                               cursor: pointer; box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
                               min-height: 50px;">
                        <i aria-hidden="true" class="fa ms-1 fa-camera"></i>&nbsp;Camera
                    </button>

                    <button @onclick="Predict" disabled="@isPredicting"
                            style="display: flex; align-items: center; justify-content: center;
                               background-color: #2563eb; color: white; padding: 12px 25px;
                               border: none; border-radius: 8px; font-size: 16px; font-weight: bold;
                               cursor: pointer; box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
                               min-height: 50px; opacity: @(isPredicting ? "0.6" : "1");">
                        @if (isPredicting)
                        {
                            <span>
                                <i class="fa fa-spinner fa-spin" aria-hidden="true"></i>&nbsp;Searching...
                            </span>
                        }
                        else
                        {
                            <span>
                                <i class="fa fa-search ms-1" aria-hidden="true"></i>&nbsp;Search
                            </span>
                        }

                    </button>
                </div>
                <br />
                @* Kết quả dự đoán được sử dụng ngầm để lọc dữ liệu, không hiển thị trên giao diện *@
            </div>
        </div>

        <!-- Webcam Popup -->
        <div id="webcamModal" class="modal">
            <div class="modal-content">
                <span class="close" @onclick="CloseWebcamPopup">&times;</span>
                <div class="camera-container">
                    <video id="video" width="320" height="240" autoplay></video>
                    <canvas id="canvas" width="240" height="240" style="display:none;"></canvas>
                </div>
                <div style="display: flex; justify-content: center; gap: 10px; margin-top: 10px;">
                    <button @onclick="CaptureImage"
                            style="display: flex; align-items: center; justify-content: center;
                               background-color: #2563eb; color: white; padding: 12px 25px;
                               border: none; border-radius: 8px; font-size: 16px; font-weight: bold;
                               cursor: pointer; box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
                               min-height: 50px;">
                        Take a photo
                    </button>
                </div>
                <br />
            </div>
        </div>
    </div>
</div>

<style>
.modal {
    position: fixed;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.5);
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 1000;
}

.modal-content {
    background-color: white;
    padding: 20px;
    border-radius: 15px;
    text-align: center;
    border: 3px solid #aaa;
    box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.2);
    max-width: fit-content;
}

.close {
    position: absolute;
    top: 10px;
    right: 15px;
    font-size: 20px;
    cursor: pointer;
}

.camera-container {
    border-radius: 15px;
    border: 3px solid #ccc;
    padding: 20px;
    background-color: blue;
    display: inline-block;
}
</style>

